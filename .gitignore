# Runtime — track JSONLs for reproducibility (track small <5MB files;
# move large runs to Zenodo only if size grows substantially)
!results/raw/*.jsonl
!results/raw/*.json
results/processed/*.parquet
!results/processed/.gitkeep

# Logs — keep f2/stress experiment logs for reproducibility
!logs/
logs/*.tmp

# Large outputs
*.zip
*.tar.gz

# Large raw data (track via DVC/Zenodo, not git)
data/raw/oberschelp2020_SI_*.xlsx
data/raw/*.tar.gz
data/raw/*.zip
# Keep small reference files in raw/ tracked
